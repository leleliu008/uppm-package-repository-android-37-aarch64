    runs-on: ubuntu-latest

    env:
      GH_TOKEN: ${{ github.token }}

    steps:
      - uses: actions/checkout@v6

      - uses: actions/download-artifact@v8
        with:
          pattern: '*'
          path: .
          merge-multiple: true

      - run: ls

      - id: tagname
        run: |
          TAGNAME="$(date +%Y.%m.%d)"
          printf 'TAGNAME=%s\n' "$TAGNAME" >> "$GITHUB_OUTPUT"

      - run: sed -i 's|@TAGNAME@|${{ steps.tagname.outputs.TAGNAME }}|' *.yml

      - run: mv *.yml formula/

      - run: |
          DIRNAME="uppm-formula-repository-android-37-aarch64-${{ steps.tagname.outputs.TAGNAME }}"

          install -d "$DIRNAME"

          cp -r formula "$DIRNAME/"

          tar cvJf "$DIRNAME.tar.xz" "$DIRNAME"

      - run: |
          gh release create ${{ steps.tagname.outputs.TAGNAME }} --title ${{ steps.tagname.outputs.TAGNAME }} --notes 'These packages are created by [ndk-pkg](https://github.com/leleliu008/ndk-pkg)'

          for f in *.tar.xz
          do
            sleep 1s
            gh release upload ${{ steps.tagname.outputs.TAGNAME }} "$f"
          done

      - run: git config --global user.name  leleliu008
      - run: git config --global user.email leleliu008@gmail.com

      - run: git pull
      - run: git add formula
      - run: git commit -m 'release new version ${{ steps.tagname.outputs.TAGNAME }}'
      - run: git push origin master
